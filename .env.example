# Media roots use the platform path separator: semicolon on Windows, colon on macOS/Linux.
LOCALIS_MEDIA_DIRS=D:\Videos
# Private application state. Default on Windows: %LOCALAPPDATA%\Localis
# LOCALIS_DATA_DIR=D:\LocalisData
LOCALIS_PORT=8080
LOCALIS_HOST=0.0.0.0
LOCALIS_MAX_TRANSCODES=2
LOCALIS_CACHE_GB=20
# Full source files cached from Baidu/OpenList before computer-side SR/transcoding.
LOCALIS_CLOUD_CACHE_GB=50
LOCALIS_MAX_CLOUD_DOWNLOADS=1
# Publisher-side Baidu application identity. Once configured on the computer,
# ordinary users only see a QR code; these values are never sent to the browser.
# Keep the SecretKey out of Git, screenshots, logs and public desktop builds.
# LOCALIS_BAIDU_APP_KEY=your-reviewed-app-key
# LOCALIS_BAIDU_SECRET_KEY=your-reviewed-secret-key
# LOCALIS_BAIDU_APP_FOLDER=Localis
# LOCALIS_ENCODER=h264_nvenc
# LOCALIS_PAIR_CODE=123456
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# Source-mode override only. Packaged Windows builds locate the bundled
# Real-ESRGAN NCNN Vulkan runtime and model automatically.
# LOCALIS_AI_SR_PATH=C:\Localis\realesrgan-ncnn-vulkan.exe
# LOCALIS_AI_SR_MODELS_PATH=C:\Localis\models

# Existing TLS certificate (optional; the managed paths are detected automatically).
# LOCALIS_TLS_CERT=D:\Localis\fullchain.pem
# LOCALIS_TLS_KEY=D:\Localis\private.key
# LOCALIS_PUBLIC_HOSTNAME=192-168-1-20.server-id.lan.example.com
# LOCALIS_ALLOWED_HOSTS=localis.example.com

# Managed Cloudflare DNS-01 certificate provisioning.
# LOCALIS_BASE_DOMAIN=lan.example.com
# CLOUDFLARE_ZONE_ID=zone-id
# CLOUDFLARE_API_TOKEN=zone-scoped-dns-edit-token
# ACME_EMAIL=you@example.com
# LOCALIS_LAN_IP=192.168.1.20
# LOCALIS_ACME_STAGING=1
# Test-only escape hatch. Production startup rejects staging certificates by default.
# LOCALIS_ALLOW_STAGING_CERT=1

# Development only. Never use on a shared LAN.
# LOCALIS_AUTH_DISABLED=1
